{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌾 Run All (FastAPI + Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🚀 1. FastAPI WebApp (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "webapp.backend.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "📊 2. Streamlit Portal (Port 8501)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/app.py",
        "--server.port",
        "8501"
      ],
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 3. Run Pytest Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "webapp/tests/test_api.py",
        "-v"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🌟 Debug Both (FastAPI & Streamlit concurrently)",
      "configurations": [
        "🚀 1. FastAPI WebApp (Port 8000)",
        "📊 2. Streamlit Portal (Port 8501)"
      ],
      "stopAll": true
    }
  ]
}
